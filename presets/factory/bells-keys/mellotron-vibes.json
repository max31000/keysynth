{
  "format": 2,
  "meta": {
    "name": "Mellotron Vibes",
    "category": "Bells & Keys",
    "tags": [
      "mellotron",
      "vibraphone",
      "tape",
      "60s",
      "sampled"
    ],
    "description": "MelloSFZotron vibraphone tapes (8 s, no loop; CC1 = pitch): soft, wobbly 60s tape vibes with a small plate.",
    "author": "factory"
  },
  "tempo": 120,
  "layers": [
    {
      "name": "Tape Vibes",
      "zone": {
        "key_lo": 0,
        "key_hi": 127,
        "vel_lo": 1,
        "vel_hi": 127,
        "transpose": 0,
        "channel": 0,
        "volume_db": 0.0,
        "pan": 0.0,
        "mute": false,
        "solo": false,
        "sustain": true
      },
      "instrument": {
        "type": "sampler",
        "params": {
          "volume_db": 6
        },
        "state": {
          "sfz": "assets/samples/mellosfzotron/Vibes.sfz"
        }
      },
      "fx": [
        {
          "type": "reverb",
          "bypass": false,
          "params": {
            "mode": 1,
            "mix": 0.15,
            "decay": 1.2,
            "size": 0.45,
            "predelay_ms": 10,
            "damp_hf": 0.45,
            "low_cut_hz": 120,
            "high_cut_hz": 9000
          }
        }
      ]
    }
  ],
  "master": {
    "volume_db": -4.4,
    "fx": [
      {
        "type": "limiter",
        "bypass": false,
        "params": {
          "ceiling_db": -1,
          "release_ms": 80
        }
      }
    ]
  }
}
