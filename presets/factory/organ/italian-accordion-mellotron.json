{
  "format": 2,
  "meta": {
    "name": "Italian Accordion (Mellotron)",
    "category": "Organ",
    "tags": [
      "accordion",
      "mellotron",
      "tape",
      "folk",
      "sampled"
    ],
    "description": "MelloSFZotron Italian accordion tapes (8 s, no loop; CC1 = pitch as on the sfz) in a small room. Folk, waltz and chanson parts.",
    "author": "factory"
  },
  "tempo": 120,
  "layers": [
    {
      "name": "Accordion",
      "zone": {
        "key_lo": 0,
        "key_hi": 127,
        "vel_lo": 1,
        "vel_hi": 127,
        "transpose": 0,
        "channel": 0,
        "volume_db": 0.0,
        "pan": 0.0,
        "mute": false,
        "solo": false,
        "sustain": true
      },
      "instrument": {
        "type": "sampler",
        "params": {
          "volume_db": 6
        },
        "state": {
          "sfz": "assets/samples/mellosfzotron/Italian_Accordion.sfz"
        }
      },
      "fx": [
        {
          "type": "reverb",
          "bypass": false,
          "params": {
            "mode": 2,
            "mix": 0.12,
            "decay": 0.9,
            "size": 0.35,
            "predelay_ms": 8,
            "damp_hf": 0.45,
            "low_cut_hz": 120,
            "high_cut_hz": 9000
          }
        }
      ]
    }
  ],
  "master": {
    "volume_db": -4.1,
    "fx": [
      {
        "type": "limiter",
        "bypass": false,
        "params": {
          "ceiling_db": -1,
          "release_ms": 80
        }
      }
    ]
  }
}
