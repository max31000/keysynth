// Version + icon resource for keysynth-engine.exe (configured by engine/CMakeLists.txt). Do not put code here.
#include <winver.h>

// First icon resource = the exe icon (Explorer, Start menu, taskbar, Alt+Tab).
1 ICON "@KS_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KS_VERSION_MAJOR@,@KS_VERSION_MINOR@,@KS_VERSION_PATCH@,0
 PRODUCTVERSION @KS_VERSION_MAJOR@,@KS_VERSION_MINOR@,@KS_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "keysynth"
            VALUE "FileDescription", "keysynth"
            VALUE "FileVersion", "@KS_VERSION@"
            VALUE "InternalName", "keysynth-engine"
            VALUE "LegalCopyright", "AGPL-3.0-or-later"
            VALUE "OriginalFilename", "keysynth-engine.exe"
            VALUE "ProductName", "keysynth"
            VALUE "ProductVersion", "@KS_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
